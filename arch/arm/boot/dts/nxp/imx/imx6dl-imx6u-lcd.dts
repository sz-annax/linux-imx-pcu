/dts-v1/;

#include "imx6dl.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "imx6u-lcd-linux.dtsi"

/ {
	model = "IM356-M-A LCD Display Platform";
	compatible = "annax,imx6u-lcd", "fsl,imx6dl";

	aliases {
		rtc0 = &board_rtc;
		rtc1 = &snvs_rtc;
	};

	chosen {
		stdout-path = &uart1;
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_keys>;

		factory-reset {
			label = "Factory reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio4 30 GPIO_ACTIVE_LOW>;
			debounce-interval = <30>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_leds>;

		error {
			label = "imx6u-lcd:red:error";
			gpios = <&gpio3 23 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};

	ir-receiver {
		compatible = "gpio-ir-receiver";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ir>;
		gpios = <&gpio2 23 GPIO_ACTIVE_LOW>;
	};

	memory@10000000 {
		device_type = "memory";
		reg = <0x10000000 0x40000000>;
	};

	reg_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "GEN_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	reserved-memory {
		linux,cma {
			size = <0x04000000>;
		};
	};
};

&cpu0 {
	operating-points = <792000 1175000>, <396000 1150000>;
	fsl,soc-operating-points = <792000 1175000>, <396000 1175000>;
};

&{/cpus/cpu@1} {
	operating-points = <792000 1175000>, <396000 1150000>;
	fsl,soc-operating-points = <792000 1175000>, <396000 1175000>;
};

&epdc {
	status = "disabled";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

&ecspi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi1>;
	cs-gpios = <0>, <&gpio4 10 GPIO_ACTIVE_LOW>;
	status = "okay";

	tpm@1 {
		compatible = "infineon,slb9670", "tcg,tpm_tis-spi";
		reg = <1>;
		spi-max-frequency = <1000000>;
	};
};

&ecspi3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi3>;
	cs-gpios = <&gpio5 18 GPIO_ACTIVE_LOW>,
		   <&gpio4 25 GPIO_ACTIVE_LOW>,
		   <&gpio5 19 GPIO_ACTIVE_LOW>;
	status = "okay";

	watchdog@0 {
		compatible = "st,m41t94-wdt";
		reg = <0>;
		spi-max-frequency = <1000000>;
		spi-cpol;
		spi-cpha;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_watchdog>;
		wdi-gpios = <&gpio5 28 GPIO_ACTIVE_HIGH>;
		timeout-sec = <60>;
	};

	flash@1 {
		compatible = "winbond,w25q32", "jedec,spi-nor";
		reg = <1>;
		spi-max-frequency = <10000000>;
	};

	fram@2 {
		compatible = "ramtron,fm25l16b", "atmel,at25";
		reg = <2>;
		spi-max-frequency = <1000000>;
		pagesize = <2048>;
		size = <2048>;
		address-width = <16>;
	};
};

&usbotg {
	dr_mode = "peripheral";
	disable-over-current;
	status = "okay";
};

&usbh1 {
	dr_mode = "host";
	disable-over-current;
	status = "okay";
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c1>;
	clock-frequency = <100000>;
	status = "okay";

	board_rtc: rtc@51 {
		compatible = "nxp,pcf85263";
		reg = <0x51>;
	};
};

&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c2>;
	clock-frequency = <100000>;
	status = "okay";

	adc@48 {
		compatible = "ti,ads1015";
		reg = <0x48>;
		#address-cells = <1>;
		#size-cells = <0>;
		#io-channel-cells = <1>;

		channel@4 {
			reg = <4>;
			ti,gain = <1>;
			ti,datarate = <4>;
		};

		channel@5 {
			reg = <5>;
			ti,gain = <1>;
			ti,datarate = <4>;
		};

		channel@6 {
			reg = <6>;
			ti,gain = <1>;
			ti,datarate = <4>;
		};

		channel@7 {
			reg = <7>;
			ti,gain = <1>;
			ti,datarate = <4>;
		};
	};

	temperature-sensor@49 {
		compatible = "national,lm75b";
		reg = <0x49>;
		vs-supply = <&reg_3v3>;
	};
};

&i2c3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c3>;
	clock-frequency = <100000>;
	status = "okay";
};

&i2c4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c4>;
	clock-frequency = <100000>;
	status = "okay";
};

&usdhc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc2>;
	bus-width = <4>;
	max-frequency = <25000000>;
	cd-gpios = <&gpio3 20 GPIO_ACTIVE_LOW>;
	vmmc-supply = <&reg_3v3>;
	vqmmc-supply = <&reg_3v3>;
	no-1-8-v;
	disable-wp;
	status = "okay";
};

&usdhc4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc4>;
	bus-width = <8>;
	max-frequency = <25000000>;
	non-removable;
	vmmc-supply = <&reg_3v3>;
	vqmmc-supply = <&reg_3v3>;
	no-1-8-v;
	status = "okay";
};

&fec {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fec>;
	phy-mode = "rmii";
	phy-handle = <&ethphy>;
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy: ethernet-phy@1 {
			reg = <1>;
			reset-gpios = <&gpio7 12 GPIO_ACTIVE_LOW>;
			reset-assert-us = <10000>;
			reset-deassert-us = <100000>;
		};
	};
};

&gpio1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_backlight_off &pinctrl_tpm_reset>;

	tpm-reset-hog {
		gpio-hog;
		gpios = <2 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "tpm-reset-deasserted";
	};

	backlight-off-hog {
		gpio-hog;
		gpios = <16 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "backlight-off";
	};
};

&gpio3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_panel_off>;

	panel-off-hog {
		gpio-hog;
		gpios = <28 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "panel-power-off";
	};
};

&iomuxc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_board_id>;

	pinctrl_board_id: boardidgrp {
		fsl,pins = <
			MX6QDL_PAD_CSI0_DAT18__GPIO6_IO04 0x130b0
			MX6QDL_PAD_CSI0_DAT16__GPIO6_IO02 0x130b0
			MX6QDL_PAD_CSI0_DAT14__GPIO6_IO00 0x130b0
			MX6QDL_PAD_CSI0_DAT12__GPIO5_IO30 0x130b0
			MX6QDL_PAD_CSI0_DAT19__GPIO6_IO05 0x130b0
			MX6QDL_PAD_CSI0_DAT17__GPIO6_IO03 0x130b0
			MX6QDL_PAD_CSI0_DAT15__GPIO6_IO01 0x130b0
			MX6QDL_PAD_CSI0_DAT13__GPIO5_IO31 0x130b0
		>;
	};

	pinctrl_ecspi1: ecspi1grp {
		fsl,pins = <
			MX6QDL_PAD_KEY_COL0__ECSPI1_SCLK 0x100b1
			MX6QDL_PAD_KEY_ROW0__ECSPI1_MOSI 0x100b1
			MX6QDL_PAD_KEY_COL1__ECSPI1_MISO 0x100b1
			MX6QDL_PAD_KEY_COL2__GPIO4_IO10 0x1b0b0
		>;
	};

	pinctrl_ecspi3: ecspi3grp {
		fsl,pins = <
			MX6QDL_PAD_DISP0_DAT0__ECSPI3_SCLK 0x100b1
			MX6QDL_PAD_DISP0_DAT1__ECSPI3_MOSI 0x100b1
			MX6QDL_PAD_DISP0_DAT2__ECSPI3_MISO 0x100b1
			MX6QDL_PAD_CSI0_PIXCLK__GPIO5_IO18 0x1b0b0
			MX6QDL_PAD_DISP0_DAT4__GPIO4_IO25 0x1b0b0
			MX6QDL_PAD_CSI0_MCLK__GPIO5_IO19 0x1b0b0
		>;
	};

	pinctrl_tpm_reset: tpmresetgrp {
		fsl,pins = <MX6QDL_PAD_GPIO_2__GPIO1_IO02 0x1b0b0>;
	};

	pinctrl_watchdog: watchdoggrp {
		fsl,pins = <MX6QDL_PAD_CSI0_DAT10__GPIO5_IO28 0x1b0b0>;
	};

	pinctrl_keys: keysgrp {
		fsl,pins = <MX6QDL_PAD_DISP0_DAT9__GPIO4_IO30 0x1b0b0>;
	};

	pinctrl_leds: ledsgrp {
		fsl,pins = <MX6QDL_PAD_EIM_D23__GPIO3_IO23 0x1b0b0>;
	};

	pinctrl_ir: irgrp {
		fsl,pins = <MX6QDL_PAD_EIM_CS0__GPIO2_IO23 0x1b0b0>;
	};

	pinctrl_i2c1: i2c1grp {
		fsl,pins = <
			MX6QDL_PAD_CSI0_DAT9__I2C1_SCL 0x4001b8b1
			MX6QDL_PAD_CSI0_DAT8__I2C1_SDA 0x4001b8b1
		>;
	};

	pinctrl_i2c2: i2c2grp {
		fsl,pins = <
			MX6QDL_PAD_KEY_COL3__I2C2_SCL 0x4001b8b1
			MX6QDL_PAD_KEY_ROW3__I2C2_SDA 0x4001b8b1
		>;
	};

	pinctrl_i2c3: i2c3grp {
		fsl,pins = <
			MX6QDL_PAD_GPIO_3__I2C3_SCL 0x4001b8b1
			MX6QDL_PAD_GPIO_6__I2C3_SDA 0x4001b8b1
		>;
	};

	pinctrl_i2c4: i2c4grp {
		fsl,pins = <
			MX6QDL_PAD_NANDF_WP_B__I2C4_SCL 0x4001b8b1
			MX6QDL_PAD_NANDF_CS3__I2C4_SDA 0x4001b8b1
		>;
	};

	pinctrl_uart1: uart1grp {
		fsl,pins = <
			MX6QDL_PAD_SD3_DAT7__UART1_TX_DATA 0x1b0b1
			MX6QDL_PAD_SD3_DAT6__UART1_RX_DATA 0x1b0b1
		>;
	};

	pinctrl_usdhc2: usdhc2grp {
		fsl,pins = <
			MX6QDL_PAD_SD2_CLK__SD2_CLK 0x17059
			MX6QDL_PAD_SD2_CMD__SD2_CMD 0x17059
			MX6QDL_PAD_SD2_DAT0__SD2_DATA0 0x17059
			MX6QDL_PAD_SD2_DAT1__SD2_DATA1 0x17059
			MX6QDL_PAD_SD2_DAT2__SD2_DATA2 0x17059
			MX6QDL_PAD_SD2_DAT3__SD2_DATA3 0x17059
			MX6QDL_PAD_EIM_D20__GPIO3_IO20 0x1b0b0
		>;
	};

	pinctrl_usdhc4: usdhc4grp {
		fsl,pins = <
			MX6QDL_PAD_SD4_CLK__SD4_CLK 0x17059
			MX6QDL_PAD_SD4_CMD__SD4_CMD 0x17059
			MX6QDL_PAD_SD4_DAT0__SD4_DATA0 0x17059
			MX6QDL_PAD_SD4_DAT1__SD4_DATA1 0x17059
			MX6QDL_PAD_SD4_DAT2__SD4_DATA2 0x17059
			MX6QDL_PAD_SD4_DAT3__SD4_DATA3 0x17059
			MX6QDL_PAD_SD4_DAT4__SD4_DATA4 0x17059
			MX6QDL_PAD_SD4_DAT5__SD4_DATA5 0x17059
			MX6QDL_PAD_SD4_DAT6__SD4_DATA6 0x17059
			MX6QDL_PAD_SD4_DAT7__SD4_DATA7 0x17059
		>;
	};

	pinctrl_fec: fecgrp {
		fsl,pins = <
			MX6QDL_PAD_ENET_MDC__ENET_MDC 0x1b0b0
			MX6QDL_PAD_ENET_MDIO__ENET_MDIO 0x1b0b0
			MX6QDL_PAD_ENET_CRS_DV__ENET_RX_EN 0x1b0b0
			MX6QDL_PAD_ENET_RXD0__ENET_RX_DATA0 0x1b0b0
			MX6QDL_PAD_ENET_RXD1__ENET_RX_DATA1 0x1b0b0
			MX6QDL_PAD_ENET_TX_EN__ENET_TX_EN 0x1b0b0
			MX6QDL_PAD_ENET_TXD0__ENET_TX_DATA0 0x1b0b0
			MX6QDL_PAD_ENET_TXD1__ENET_TX_DATA1 0x1b0b0
			MX6QDL_PAD_GPIO_16__ENET_REF_CLK 0x4001b0b0
			MX6QDL_PAD_GPIO_17__GPIO7_IO12 0x1b0b0
		>;
	};

	pinctrl_backlight_off: backlightoffgrp {
		fsl,pins = <MX6QDL_PAD_SD1_DAT0__GPIO1_IO16 0x1b0b0>;
	};

	pinctrl_panel_off: paneloffgrp {
		fsl,pins = <MX6QDL_PAD_EIM_D28__GPIO3_IO28 0x1b0b0>;
	};
};
