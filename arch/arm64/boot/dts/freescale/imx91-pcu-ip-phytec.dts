/dts-v1/;

#include "imx91-phycore-som.dtsi"

&ele_fw2 {
	memory-region = <&ele_reserved>;
};

/ {
	model = "ANNAX i.MX91 PCU Audio phyCORE V1";
	compatible = "annax,imx91-pcu-ip-phytec", "phytec,imx91-phycore-som",
		     "fsl,imx91";

	chosen {
		stdout-path = &lpuart1;
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_gpio_keys>;
		#address-cells = <1>;
		#size-cells = <0>;
		autorepeat;

		// GPIO_IO12 KEY_alarm
		key-1 {
			linux,code = <KEY_1>;
			label = "SW1";
			gpios = <&gpio2 12 GPIO_ACTIVE_LOW>;
			gpio-key,wakeup;
			debounce-interval = <20>;
		};
	};

	key-cyber {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_cyber_keys>;
		#address-cells = <1>;
		#size-cells = <0>;
		autorepeat;

		key-cyber {
			linux,code = <KEY_C>;
			label = "cyber-key";
			gpios = <&gpio2 21 GPIO_ACTIVE_LOW>;
			gpio-key,wakeup;
			debounce-interval = <20>;
		};
	};

	reg_usb1_vbus: regulator-usb1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "USB1_VBUS";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	reg_vsd3v3: regulator-vsd3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VSD_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_gpio_leds>;

		// heartbeat {
		// 	label = "heartbeat";
		// 	gpios = <&gpio2 4 GPIO_ACTIVE_LOW>;
		// 	linux,default-trigger = "heartbeat";
		// };

		led3-red {
			label = "led3-red";
			gpios = <&gpio3 21 GPIO_ACTIVE_HIGH>;
		};

		led3-green {
			label = "led3-green";
			gpios = <&gpio4 16 GPIO_ACTIVE_HIGH>;
		};

		led3-blue {
			label = "led3-blue";
			gpios = <&gpio4 26 GPIO_ACTIVE_HIGH>;
		};

		led4-red {
			label = "led4-red";
			gpios = <&gpio2 18 GPIO_ACTIVE_HIGH>;
		};

		led4-green {
			label = "led4-green";
			gpios = <&gpio4 2 GPIO_ACTIVE_HIGH>;
		};

		led4-blue {
			label = "led4-blue";
			gpios = <&gpio4 7 GPIO_ACTIVE_HIGH>;
		};
	};

	sound {
		compatible = "fsl,imx-audio-ak4619";
		model = "ak4619-audio";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_amp_en>;
		audio-cpu = <&sai3>;
		audio-codec = <&ak4619_codec>;
		spk-con-gpio = <&gpio2 15 GPIO_ACTIVE_HIGH>;
		audio-routing =
			"Ext Spk", "AOUT1L",
			"Ext Spk", "AOUT1R";
	};

	sound-micfil {
		compatible = "fsl,imx-audio-card";
		model = "micfil-audio";

		pri-dai-link {
			link-name = "micfil hifi";
			format = "i2s";

			cpu {
				sound-dai = <&micfil>;
			};
		};
	};
};

/* Ethernet */
&ethphy1 {
	ti,leds-polarity = <0>;
};

&lpi2c2 {
	clock-frequency = <400000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c2>;
	pinctrl-1 = <&pinctrl_lpi2c2>;
	status = "okay";

	ak4619_codec: ak4619-codec@10 {
		compatible = "asahi-kasei,ak4619";
		reg = <0x10>;
		clocks = <&clk IMX91_CLK_SAI3_GATE>;
		clock-names = "mclk";
		#sound-dai-cells = <0>;
	};

	pcf85263@51 {
		compatible = "nxp,pcf85263";
		reg = <0x51>;
	};

	eeprom@50 {
		compatible = "atmel,24c64";
		reg = <0x50>;
		pagesize = <16>;
		size = <8192>;
		vcc-supply = <&reg_vsd3v3>;
	};
};

/* lpspi3 work as a lpspi master bus */
&lpspi3 {
	num-cs = <3>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpspi3>;
	cs-gpios = <&gpio2 7 GPIO_ACTIVE_LOW>, <&gpio2 6 GPIO_ACTIVE_LOW>, <&gpio2 8 GPIO_ACTIVE_LOW>;
	status = "okay";

	tpm_tis: tpm@0 {
		compatible = "infineon,slb9670", "tcg,tpm_tis-spi";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};

	fram@1 {
		compatible = "ramtron,fm25l16b", "atmel,at25";
		reg = <1>;
		spi-max-frequency = <1000000>;
		size = <2048>;
		pagesize = <2048>;
		address-width = <16>;
	};

	m41t94: rtc@2 {
		compatible = "st,m41t94-wdt";
		reg = <2>;
		spi-max-frequency = <2000000>;
		timeout-sec = <120>;
	};
};

&lpuart1 { /* console */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

&media_blk_ctrl {
	status = "disabled";
};

&micfil {
	#sound-dai-cells = <0>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_pdm>;
	pinctrl-1 = <&pinctrl_pdm_sleep>;
	assigned-clocks = <&clk IMX91_CLK_PDM>;
	assigned-clock-parents = <&clk IMX91_CLK_AUDIO_PLL>;
	assigned-clock-rates = <49152000>;
	status = "okay";
};

&mu1 {
	status = "okay";
};

&mu2 {
	status = "okay";
};

&sai1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_sai1>;
	pinctrl-1 = <&pinctrl_sai1_sleep>;
	assigned-clocks = <&clk IMX91_CLK_SAI1>;
	assigned-clock-parents = <&clk IMX91_CLK_AUDIO_PLL>;
	assigned-clock-rates = <12288000>;
	fsl,sai-mclk-direction-output;
	status = "okay";
};

&sai3 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_sai3>;
	pinctrl-1 = <&pinctrl_sai3_sleep>;
	assigned-clocks = <&clk IMX91_CLK_SAI3>;
	assigned-clock-parents = <&clk IMX91_CLK_AUDIO_PLL>;
	assigned-clock-rates = <12288000>;
	fsl,sai-mclk-direction-output;
	status = "okay";
};

&usbotg1 {
	dr_mode = "peripheral";
	hnp-disable;
	srp-disable;
	adp-disable;
	disable-over-current;
	samsung,picophy-pre-emp-curr-control = <3>;
	samsung,picophy-dc-vol-level-adjust = <7>;
	status = "okay";
};

&usbphynop1 {
	vbus-supply = <&reg_usb1_vbus>;
};

&usbphynop2 {
	status = "disabled";
};

&usbotg2 {
	dr_mode = "otg";
	hnp-disable;
	srp-disable;
	adp-disable;
	usb-role-switch;
	disable-over-current;
	samsung,picophy-pre-emp-curr-control = <3>;
	samsung,picophy-dc-vol-level-adjust = <7>;
	status = "disabled";
};

&usdhc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc1>;
	bus-width = <8>;
	max-frequency = <26000000>;
	fsl,tuning-step = <1>;
	non-removable;
	no-1-8-v;
	status = "okay";
};

&usdhc2 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_cd>;
	pinctrl-1 = <&pinctrl_usdhc2_100mhz>, <&pinctrl_usdhc2_cd>;
	pinctrl-2 = <&pinctrl_usdhc2_200mhz>, <&pinctrl_usdhc2_cd>;
	cd-gpios = <&gpio3 0 GPIO_ACTIVE_LOW>;
	no-mmc;
	no-sdio;
	bus-width = <4>;
	vmmc-supply = <&reg_vsd3v3>;
	status = "okay";
};

&wdog3 {
	status = "okay";
};

&xcvr {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_spdif>;
	pinctrl-1 = <&pinctrl_spdif_sleep>;
	assigned-clocks = <&clk IMX91_CLK_SPDIF>,
			 <&clk IMX91_CLK_AUDIO_XCVR>;
	assigned-clock-parents = <&clk IMX91_CLK_AUDIO_PLL>,
			 <&clk IMX91_CLK_SYS_PLL_PFD1_DIV2>;
	assigned-clock-rates = <12288000>, <200000000>;
	status = "disabled";
};

&iomuxc {
	pinctrl_gpio_leds: gpio-leds {
		fsl,pins = <
			MX91_PAD_GPIO_IO04__GPIO2_IO4		0x31e
			MX91_PAD_SD3_CMD__GPIO3_IO21		0x31e
			MX91_PAD_ENET2_TD3__GPIO4_IO16		0x31e
			MX91_PAD_ENET2_RD2__GPIO4_IO26		0x31e
			MX91_PAD_GPIO_IO18__GPIO2_IO18		0x31e
			MX91_PAD_ENET1_TD3__GPIO4_IO2		0x31e
		>;
	};
	pinctrl_amp_en: gpio-amp {
		fsl,pins = <
			MX91_PAD_GPIO_IO15__GPIO2_IO15		0x51e
		>;
	};
	pinctrl_gpio_keys: gpio-keys {
		fsl,pins = <
			MX91_PAD_GPIO_IO12__GPIO2_IO12		0x31e
		>;
	};

	pinctrl_cyber_keys: key-cyber {
		fsl,pins = <
			MX91_PAD_GPIO_IO21__GPIO2_IO21 0x31e
		>;
	};

	pinctrl_lpspi3: lpspi3grp {
		fsl,pins = <
			MX91_PAD_GPIO_IO06__GPIO2_IO6		0x3fe
			MX91_PAD_GPIO_IO07__GPIO2_IO7		0x3fe
			MX91_PAD_GPIO_IO08__GPIO2_IO8		0x3fe
			MX91_PAD_GPIO_IO09__LPSPI3_SIN		0x1fe
			MX91_PAD_GPIO_IO10__LPSPI3_SOUT		0x1fe
			MX91_PAD_GPIO_IO11__LPSPI3_SCK		0x1fe
		>;
	};

	pinctrl_uart1: uart1grp {
		fsl,pins = <
			MX91_PAD_UART1_RXD__LPUART1_RX			0x31e
			MX91_PAD_UART1_TXD__LPUART1_TX			0x31e
		>;
	};

	pinctrl_lpi2c2: lpi2c2grp {
		fsl,pins = <
			MX91_PAD_I2C2_SCL__LPI2C2_SCL			0x40000b9e
			MX91_PAD_I2C2_SDA__LPI2C2_SDA			0x40000b9e
		>;
	};

	pinctrl_pdm: pdmgrp {
		fsl,pins = <
			MX91_PAD_PDM_CLK__PDM_CLK			0x31e
			MX91_PAD_PDM_BIT_STREAM0__PDM_BIT_STREAM0	0x31e
			MX91_PAD_PDM_BIT_STREAM1__PDM_BIT_STREAM1	0x31e
		>;
	};

	pinctrl_pdm_sleep: pdmsleepgrp {
		fsl,pins = <
			MX91_PAD_PDM_CLK__GPIO1_IO8			0x31e
			MX91_PAD_PDM_BIT_STREAM0__GPIO1_IO9		0x31e
			MX91_PAD_PDM_BIT_STREAM1__GPIO1_IO10		0x31e
		>;
	};

	pinctrl_sai1: sai1grp {
		fsl,pins = <
			MX91_PAD_SAI1_TXC__SAI1_TX_BCLK			0x31e
			MX91_PAD_SAI1_TXFS__SAI1_TX_SYNC		0x31e
			MX91_PAD_SAI1_TXD0__SAI1_TX_DATA0		0x31e
			MX91_PAD_SAI1_RXD0__SAI1_RX_DATA0		0x31e
		>;
	};

	pinctrl_sai1_sleep: sai1sleepgrp {
		fsl,pins = <
			MX91_PAD_SAI1_TXC__GPIO1_IO12                   0x51e
			MX91_PAD_SAI1_TXFS__GPIO1_IO11			0x51e
			MX91_PAD_SAI1_TXD0__GPIO1_IO13			0x51e
			MX91_PAD_SAI1_RXD0__GPIO1_IO14			0x51e
		>;
	};

	/* need to config the SION for data and cmd pad, refer to ERR052021 */
	pinctrl_usdhc1: usdhc1grp {
		fsl,pins = <
			MX91_PAD_SD1_CLK__USDHC1_CLK		0x1582
			MX91_PAD_SD1_CMD__USDHC1_CMD		0x40001382
			MX91_PAD_SD1_DATA0__USDHC1_DATA0	0x40001382
			MX91_PAD_SD1_DATA1__USDHC1_DATA1	0x40001382
			MX91_PAD_SD1_DATA2__USDHC1_DATA2	0x40001382
			MX91_PAD_SD1_DATA3__USDHC1_DATA3	0x40001382
			MX91_PAD_SD1_DATA4__USDHC1_DATA4	0x40001382
			MX91_PAD_SD1_DATA5__USDHC1_DATA5	0x40001382
			MX91_PAD_SD1_DATA6__USDHC1_DATA6	0x40001382
			MX91_PAD_SD1_DATA7__USDHC1_DATA7	0x40001382
			MX91_PAD_SD1_STROBE__USDHC1_STROBE	0x1582
		>;
	};

	pinctrl_spdif: spdifgrp {
		fsl,pins = <
			MX91_PAD_GPIO_IO22__SPDIF_IN		0x3fe
			MX91_PAD_GPIO_IO23__SPDIF_OUT		0x3fe
		>;
	};

	pinctrl_spdif_sleep: spdifsleepgrp {
		fsl,pins = <
			MX91_PAD_GPIO_IO22__GPIO2_IO22		0x31e
			MX91_PAD_GPIO_IO23__GPIO2_IO23		0x31e
		>;
	};

	pinctrl_usdhc2_cd: usdhc2cdgrp {
		fsl,pins = <
			MX91_PAD_SD2_CD_B__GPIO3_IO0		0x31e
		>;
	};

	pinctrl_usdhc2: usdhc2grp {
		fsl,pins = <
			MX91_PAD_SD2_CLK__USDHC2_CLK		0x179e
			MX91_PAD_SD2_CMD__USDHC2_CMD		0x139e
			MX91_PAD_SD2_DATA0__USDHC2_DATA0	0x138e
			MX91_PAD_SD2_DATA1__USDHC2_DATA1	0x138e
			MX91_PAD_SD2_DATA2__USDHC2_DATA2	0x138e
			MX91_PAD_SD2_DATA3__USDHC2_DATA3	0x139e
			MX91_PAD_SD2_VSELECT__USDHC2_VSELECT	0x51e
		>;
	};

	pinctrl_usdhc2_100mhz: usdhc2-100mhzgrp {
		fsl,pins = <
			MX91_PAD_SD2_CLK__USDHC2_CLK		0x179e
			MX91_PAD_SD2_CMD__USDHC2_CMD		0x139e
			MX91_PAD_SD2_DATA0__USDHC2_DATA0	0x138e
			MX91_PAD_SD2_DATA1__USDHC2_DATA1	0x138e
			MX91_PAD_SD2_DATA2__USDHC2_DATA2	0x139e
			MX91_PAD_SD2_DATA3__USDHC2_DATA3	0x139e
			MX91_PAD_SD2_VSELECT__USDHC2_VSELECT	0x51e
		>;
	};

	pinctrl_usdhc2_200mhz: usdhc2-200mhzgrp {
		fsl,pins = <
			MX91_PAD_SD2_CLK__USDHC2_CLK		0x178e
			MX91_PAD_SD2_CMD__USDHC2_CMD		0x139e
			MX91_PAD_SD2_DATA0__USDHC2_DATA0	0x139e
			MX91_PAD_SD2_DATA1__USDHC2_DATA1	0x139e
			MX91_PAD_SD2_DATA2__USDHC2_DATA2	0x139e
			MX91_PAD_SD2_DATA3__USDHC2_DATA3	0x139e
			MX91_PAD_SD2_VSELECT__USDHC2_VSELECT	0x51e
		>;
	};

	pinctrl_sai3: sai3grp {
		fsl,pins = <
			MX91_PAD_GPIO_IO26__SAI3_TX_SYNC		0x31e
			MX91_PAD_GPIO_IO16__SAI3_TX_BCLK		0x31e
			MX91_PAD_GPIO_IO17__SAI3_MCLK			0x31e
			MX91_PAD_GPIO_IO19__SAI3_TX_DATA0		0x31e
			MX91_PAD_GPIO_IO20__SAI3_RX_DATA0		0x31e
		>;
	};

	pinctrl_sai3_sleep: sai3grpsleep {
		fsl,pins = <
			MX91_PAD_GPIO_IO26__GPIO2_IO26			0x51e
			MX91_PAD_GPIO_IO16__GPIO2_IO16			0x51e
			MX91_PAD_GPIO_IO17__GPIO2_IO17			0x51e
			MX91_PAD_GPIO_IO19__GPIO2_IO19			0x51e
			MX91_PAD_GPIO_IO20__GPIO2_IO20			0x51e
		>;
	};
};
